<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.ds4.iogpu-wired-limit</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/sbin/sysctl -w iogpu.wired_limit_mb=241664 iogpu.disable_wired_collector=1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>